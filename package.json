{
	"name": "svaro",
	"description": "A modular visual editor for Svelte 5",
	"version": "0.1.0",
	"author": "Nathaniel Tampus",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotnize/svaro.git"
	},
	"bugs": {
		"url": "https://github.com/dotnize/svaro/issues"
	},
	"keywords": [
		"page",
		"layout",
		"editor",
		"visual",
		"builder",
		"drag",
		"drop",
		"svelte"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"svelte-dnd-action": "^0.9.52"
	},
	"peerDependencies": {
		"svelte": "^5.0.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.3.0",
		"@sveltejs/kit": "^2.7.2",
		"@sveltejs/package": "^2.3.6",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/eslint": "^9.6.1",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.13.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^15.11.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"prettier-plugin-tailwindcss": "^0.6.8",
		"publint": "^0.2.11",
		"svelte": "^5.0.5",
		"svelte-check": "^4.0.5",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.11.0",
		"vite": "^5.4.10",
		"vitest": "^2.1.3"
	}
}
